const int HASH_SIZE = 101;  // prime for fewer collisions

struct HashNode {
    User      data;
    HashNode* next = nullptr;  // chaining
};

class UserHashTable {
    HashNode* table[HASH_SIZE];

    int hashFn(const string& email) {
        int h = 0;
        
        for (char c : email)
            h = (h * 31 + c) % HASH_SIZE;
        return (h + HASH_SIZE) % HASH_SIZE;
    }
public:
    UserHashTable() {
        fill(table, table + HASH_SIZE, nullptr);
    }
    void insertUser(User u) {
        int i = hashFn(u.email);
        HashNode* n = new HashNode;
        n->data = u;
        n->next = table[i];   // prepend chain
        table[i] = n;
    }
    User* searchUser(const string& email) {
        int i = hashFn(email);
        for (HashNode* t = table[i]; t; t = t->next)
            if (t->data.email == email)
                return &t->data;  // O(1) avg
        return nullptr;
    }
};
UserHashTable userHash;
