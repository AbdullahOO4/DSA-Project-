
struct TreeNode {
    Donation  data;
    TreeNode* left  = nullptr;
    TreeNode* right = nullptr;
};

class DonationBST {
    TreeNode* root = nullptr;

    TreeNode* insert(TreeNode* n, Donation d) {
        if (!n) {
            TreeNode* nn = new TreeNode;
            nn->data = d; return nn;
        }
        if (d.foodItem < n->data.foodItem)
            n->left  = insert(n->left,  d);
        else
            n->right = insert(n->right, d);
        return n;
    }

    void inorder(TreeNode* n,
                  vector<Donation>& out) {
        if (!n) return;
        inorder(n->left, out);   // left subtree
        out.push_back(n->data);  // visit root
        inorder(n->right, out);  // right subtree
    }

public:
    void insertDonation(Donation d) {
        root = insert(root, d);
    }
    vector<Donation> getSorted() {
        vector<Donation> v;
        inorder(root, v); return v;
    }
};
